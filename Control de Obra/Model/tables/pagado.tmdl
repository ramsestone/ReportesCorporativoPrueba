table pagado

	measure Total_total_pagado =
			
			SUMX ( pagado, VALUE ( pagado[total] ) )

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_SI_Pagadoo =
			
			[Total_SI_pagado] + [Total_total_pagado]

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pendiente por Pagar' =
			
			CALCULATE(SUM(presupuesto_compras[presupuesto_compras_real]) - SUM(pagado[total]) + [Total_SI_Pagadoo])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avance Financiero' =
			
			var decimal = CALCULATE((SUM(pagado[total]) + [Total_SI_pagadoo])/SUM(presupuesto_compras[presupuesto_compras_real]))
			RETURN
			decimal / 100
		formatString: 0.00\ %;-0.00\ %;0.00\ %

	column numpro
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: numpro

		annotation SummarizationSetBy = Automatic

	column factura
		dataType: string
		summarizeBy: none
		sourceColumn: factura

		annotation SummarizationSetBy = Automatic

	column fecha
		dataType: dateTime
