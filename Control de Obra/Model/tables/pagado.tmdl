		variation Variación
			isDefault
			relationship: 9fa30a2a-5d11-4cde-b247-7f9e5955df84
			defaultHierarchy: LocalDateTable_c8bbc86b-736f-4e83-a197-1ba4868d27e8.'Jerarquía de fechas'

