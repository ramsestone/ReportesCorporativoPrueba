	column 'Tipo de Pago' =
			
			IF(
			    pagado[tm] = 57,
			    "EFECTIVO",
			    "TRANSFERENCIA"
			)
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition pagado = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(File.Contents("C:\REPORTES_CORPORATIVO_PBI\outputs\proforma_data.xlsx"), null, true),
				    pagado_Sheet = Origen{[Item="pagado",Kind="Sheet"]}[Data],
				    #"Encabezados promovidos" = Table.PromoteHeaders(pagado_Sheet, [PromoteAllScalars=true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos",{{"numpro", Int64.Type}, {"factura", type text}, {"fecha", type date}, {"tm", Int64.Type}, {"fechavenc", type date}, {"concepto", type text}, {"cc", type text}, {"referenciaoc", Int64.Type}, {"monto", type number}, {"tipocambio", Int64.Type}, {"iva", Int64.Type}, {"year", Int64.Type}, {"mes", Int64.Type}, {"poliza", Int64.Type}, {"tp", type text}, {"es_factura", type text}, {"autorizapago", type text}, {"total", type number}, {"folio_gxc", type any}, {"source", type text}, {"id_cc", type text}, {"id_factura", type text}, {"id_proveedor", type text}, {"monto_iva", type number}, {"monto_facturado_snIva", type number}, {"monto_facturado_conIva", type number}, {"porcentaje_pagado", type number}, {"porcentaje_pagadob", type number}, {"porcentaje_pagado_iva", type number}, {"porcentaje_iva_pagado", Int64.Type}, {"sub_total_pagSI", type number}})
				in
				    #"Tipo cambiado"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

