		annotation TemplateId = DateHierarchy

	partition LocalDateTable_29d7bf1d-2321-4b9f-a67a-da81a83e95ba = calculated
		mode: import
		source = Calendar(Date(Year(MIN('orden_compra'[fecha])), 1, 1), Date(Year(MAX('orden_compra'[fecha])), 12, 31))

	annotation __PBI_LocalDateTable = true

